<sw-card
        :title="$tc('tb-product-extra-info.cardTitle')"
        :is-loading="isLoading"
>
    <mt-textarea
            v-if="extraInfo"
            v-model="extraInfo.extraText"
            :label="$tc('tb-product-extra-info.extraTextLabel')"
            :placeholder="$tc('tb-product-extra-info.extraTextPlaceholder')"
            :disabled="disabled || isSaving"
    />

    <mt-number-field
            v-if="extraInfo"
            v-model="extraInfo.priority"
            :label="$tc('tb-product-extra-info.priorityLabel')"
            :min="0"
            :step="1"
            :disabled="disabled || isSaving"
    />

    <template #footer>
        <mt-button
                variant="primary"
                :disabled="disabled || !extraInfo"
                :is-loading="isSaving"
                @click="saveExtraInfo"
        >
            {{ $tc('tb-product-extra-info.saveButton') }}
        </mt-button>
    </template>
</sw-card>